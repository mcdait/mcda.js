{
  "name": "mcdajs",
  "version": "0.0.4",
  "description": "Multiple Criteria Decision Analysis library for JavaScript and TypeScript",
  "main": "./dist/index.cjs",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prettier": "prettier . --write"
  },
  "keywords": [
    "mcda",
    "mcdm",
    "decision-making",
    "topsis",
    "promethee",
    "multi-criteria",
    "optimization"
  ],
  "author": "MCDA.it",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "jest": "^30.4.2",
    "prettier": "^3.9.4",
    "publint": "^0.3.21",
    "ts-jest": "^29.4.11",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "module": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcdait/mcda.js.git"
  },
  "homepage": "https://github.com/mcdait/mcda.js",
  "bugs": {
    "url": "https://github.com/mcdait/mcda.js/issues"
  }
}
